<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="25dp"
    android:background="@color/white">

    <!-- Header Section (Same as dashboard) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:paddingHorizontal="15dp">

        <ImageView
            android:id="@+id/Icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_image"
            android:contentDescription="@string/app_name"
            android:clickable="true"
            android:onClick="showHomePage" />

        <LinearLayout
            android:id="@+id/logoTextContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/Icon"
            android:orientation="vertical"
            android:clickable="true"
            android:onClick="showHomePage">

            <TextView
                android:id="@+id/mahubePharmacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mahube"
                android:textColor="@color/button_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pharmacy"
                android:textColor="#7AB648"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:tint="#64748B"
            android:src="@drawable/account_circle"
            android:contentDescription="Profile"
            android:clickable="true"
            android:onClick="showProfilePage"/>

        <ImageView
            android:id="@+id/notificationIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:layout_toStartOf="@id/profileIcon"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="#64748B"
            android:contentDescription="Notifications" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Your Cart Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_cart"
                android:textColor="#0F172A"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cartItemsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 items in your cart"
                android:textColor="@color/secondary_textColor"
                android:textSize="16sp" />

            <!-- Cart Items List Container -->
            <LinearLayout
                android:id="@+id/cartItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/edit_box"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="15dp">
                <!-- Items will be added here dynamically -->
            </LinearLayout>

            <!-- Delivery Address Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Delivery Address"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_box"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="15dp">

                <Spinner
                    android:id="@+id/addressSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edit_box"
                    android:backgroundTint="#F8FAFC" />

                <Button
                    android:id="@+id/addNewAddressBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#F1F5F9"
                    android:text="+ Add New Address"
                    android:textAllCaps="false"
                    android:textColor="#1E40AF"
                    android:textSize="14sp"
                    android:onClick="showAddressPage" />
            </LinearLayout>

            <!-- Payment Method Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Payment Method"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/paymentMethodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_box"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:padding="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pay with Card"
                    android:checked="true"
                    android:textColor="#0F172A"
                    android:padding="10dp" />

                <RadioButton
                    android:id="@+id/radioCash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pay with Cash"
                    android:textColor="#0F172A"
                    android:padding="10dp" />
            </RadioGroup>

            <!-- Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/edit_box"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtotal"
                        android:textColor="@color/secondary_textColor"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/cartSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R0.00"
                        android:textColor="#0F172A"
                        android:textSize="16sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delivery"
                        android:textColor="@color/secondary_textColor"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/cartDelivery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R15.00"
                        android:textColor="#0F172A"
                        android:textSize="16sp" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="15dp"
                    android:background="#F1F5F9" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cartTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R15.00"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnEmailCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:backgroundTint="#F1F5F9"
                android:text="Email Cart Summary"
                android:textAllCaps="false"
                android:textColor="#1E40AF"
                android:textSize="14sp"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawablePadding="10dp"
                android:paddingHorizontal="20dp"
                android:onClick="handleEmailCart" />

        </LinearLayout>
    </ScrollView>

    <!-- Checkout Button Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/white">

        <Button
            android:id="@+id/checkoutBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="@color/button_blue"
            android:text="@string/proceed_to_checkout"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="10dp"
            android:paddingHorizontal="40dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/nav_background"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:outlineAmbientShadowColor="@color/black">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" android:tint="#64748B"
            android:onClick="showHomePage"/>
        <TextView android:layout_width="1dp" android:layout_height="25dp" android:background="#DDDDDD" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Prescriptions"
            android:tint="#64748B"
            android:src="@drawable/ic_services"
            android:onClick="showServicePage"/>

        <TextView android:layout_width="1dp" android:layout_height="25dp" android:background="#DDDDDD" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Prescriptions"
            android:src="@drawable/ic_prescriptions_item"
            android:onClick="showUploadPresciptionPage"/>
        <TextView android:layout_width="1dp" android:layout_height="25dp" android:background="#DDDDDD" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Consultation"
            android:src="@drawable/ic_contact"
            android:tint="#64748B"
            android:onClick="showConsultationPage" />
        <TextView android:layout_width="1dp" android:layout_height="25dp" android:background="#DDDDDD" />
        <ImageView
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Profile"
            android:src="@drawable/ic_profile"
            android:tint="#64748B"
            android:onClick="showAboutPage" />
    </LinearLayout>
</LinearLayout>