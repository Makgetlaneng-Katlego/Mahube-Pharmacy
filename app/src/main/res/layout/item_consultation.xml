<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    android:background="@drawable/edit_box"
    android:backgroundTint="@color/white"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="15dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/consultationType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General Consultation"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/consultationDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="2026/06/08"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </RelativeLayout>

    <TextView
        android:id="@+id/consultationDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Description of the problem..."
        android:textColor="#64748B"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#F1F5F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pharmacy Feedback:"
        android:textColor="#1E40AF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pharmacyFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No feedback yet. We will get back to you shortly."
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:textStyle="italic" />

</LinearLayout>
