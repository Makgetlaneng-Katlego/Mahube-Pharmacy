<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_background"
    android:elevation="10dp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/LoginText"
            android:text="Already have an account: "
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/LoginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Login"
            android:textColor="@color/button_blue"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@drawable/background_outline"
            android:src="@drawable/back_arrow" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="15dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="@color/black"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:text="Fill in your details to get started"
                android:textColor="@color/secondary_textColor"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fullname"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/fullname"
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_outline"
                android:drawableStart="@drawable/ic_profile"
                android:hint="Enter your Fullname"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Email"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/email"
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_outline"
                android:drawableStart="@drawable/ic_email"
                android:hint="Enter your Email"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Phone Number"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/phone"
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_outline"
                android:drawableStart="@drawable/ic_phone"
                android:hint="Enter your phone number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Password"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/Pass"
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_outline"
                android:drawableStart="@drawable/ic_lock"
                android:hint="Enter your password"
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Confirm Password"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/Confirmpass"
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_outline"
                android:hint="Re-enter your password"
                android:inputType="textPassword"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Date of Birth"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/DOB"
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_outline"
                android:drawableStart="@drawable/outline_calendar_month_24"
                android:hint=""
                android:inputType="date"
                android:textColor="@color/black" />

            <Button
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_prescriptions"
                android:text="Create Account"
                android:textColor="@color/white" />

        </LinearLayout>

    </ScrollView>


</LinearLayout>
